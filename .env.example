# ==============================================================================
# SomnoScope - Variables de Entorno y Parametrización (.env.example)
# Copia este archivo a `.env` y ajusta los valores según tu entorno local o nube.
# ==============================================================================

# --- Rutas y Artefactos de Modelos ---
MODELS_DIR=./Modelos
DL_MODEL_FILE=model_tinysleepnet.pt
CLASSICAL_MODEL_FILE=best_sleep_model.pkl

# --- Servicios y Puertos ---
API_PORT=8000
DASHBOARD_PORT=8050
MLFLOW_PORT=5000
API_URL=http://localhost:8000
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Parámetros Clínicos de Procesamiento EEG ---
DEFAULT_EEG_CHANNEL=EEG Fpz-Cz
TARGET_SFREQ_HZ=100
EPOCH_DURATION_SEC=30

